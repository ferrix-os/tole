// On or off, its knob sliding over. A click, or Space while it has the
// focus, turns it over and says `toggled`.
import Fx

component Switch : Item {
    id: control
    property string text
    property bool checked: false
    property bool hovered: area.containsMouse
    signal toggled()

    implicitWidth: row.implicitWidth
    implicitHeight: max(row.implicitHeight, 22)
    activeFocusOnTab: true
    opacity: enabled ? 1 : 0.45

    Keys.onSpacePressed: { checked = !checked; toggled() }

    Row {
        id: row
        anchors.verticalCenter: parent.verticalCenter
        spacing: 8
        Rectangle {
            id: track
            width: 32; height: 18
            radius: 9
            anchors.verticalCenter: parent.verticalCenter
            color: control.checked ? Theme.accent : Theme.bar
            border.width: control.activeFocus ? 2 : 0
            border.color: control.checked ? Theme.ink : Theme.accent
            Behavior on color { ColorAnimation { duration: 120 } }
            Rectangle {
                id: knob
                y: 2
                x: control.checked ? 16 : 2
                width: 14; height: 14
                radius: 7
                color: "white"
                Behavior on x { NumberAnimation { duration: 120; easing.type: Easing.OutCubic } }
            }
        }
        Text {
            visible: control.text != ""
            anchors.verticalCenter: parent.verticalCenter
            text: control.text
            font: Theme.sans()
            color: Theme.ink
        }
    }
    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        onClicked: { control.checked = !control.checked; control.toggled() }
    }
}

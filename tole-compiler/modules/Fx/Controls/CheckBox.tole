// A box that is ticked or not, and its label. A click, or Space while it
// has the focus, turns it over and says `toggled`.
import Fx

component CheckBox : Item {
    id: control
    property string text
    property bool checked: false
    property bool hovered: area.containsMouse
    signal toggled()

    implicitWidth: row.implicitWidth
    implicitHeight: max(row.implicitHeight, 22)
    activeFocusOnTab: true
    opacity: enabled ? 1 : 0.45

    Keys.onSpacePressed: { checked = !checked; toggled() }

    Row {
        id: row
        anchors.verticalCenter: parent.verticalCenter
        spacing: 8
        Rectangle {
            id: box
            width: 16; height: 16
            radius: 4
            anchors.verticalCenter: parent.verticalCenter
            color: control.checked ? Theme.accent : Theme.bg
            border.width: control.checked && !control.activeFocus ? 0 : (control.activeFocus ? 2 : 1)
            border.color: control.activeFocus || control.hovered ? Theme.accent : Theme.ink4
            Text {
                anchors.centerIn: parent
                visible: control.checked
                text: "✓"
                font: Theme.sans(12, 700)
                color: Theme.onAccent
            }
        }
        Text {
            id: label
            visible: control.text != ""
            anchors.verticalCenter: parent.verticalCenter
            text: control.text
            font: Theme.sans()
            color: Theme.ink
        }
    }
    MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        onClicked: { control.checked = !control.checked; control.toggled() }
    }
}
